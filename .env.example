# Copy this file to .env and fill in real values before running the server.

# Port the server listens on (hosting platforms usually set this for you automatically)
PORT=4000

# Password for the admin panel (POST /api/admin/login).
# Pick something long and random - this is the only thing standing
# between the public internet and your product/order data.
ADMIN_PASSWORD=change-me-to-something-long-and-random

# --- Database (Turso) ---
# Leave both blank to use a local file (file:./data.db) for testing on your
# own computer - no account needed. For real hosting, create a free
# database at turso.tech and paste its values here so your data survives
# server restarts (see README.md for the exact steps).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Comma-separated list of origins allowed to call the API from a browser.
# Add your live site's domain here once you deploy it, e.g.:
# CORS_ORIGIN=https://yourstudio.com,https://www.yourstudio.com
CORS_ORIGIN=*

# Where order notification emails get sent (optional).
# Leave blank to skip email notifications entirely.
NOTIFY_EMAIL=hardiknehere25@gmail.com
